# =============================================================================
# Cortex — local/pilot environment placeholder template
# Copy to ".env" at the repo root (see .gitignore). Never commit real secrets.
# Full context: docs/pilot-setup.md
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose (docker-compose.yml) — variable substitution for SQL Server
# -----------------------------------------------------------------------------
# SA password for the mssql service. Override for anything beyond throwaway local dev.
# Compose default if unset is documented in docker-compose.yml.
CORTEX_SQL_PASSWORD=YourLocalDevSqlPassword_NotForProduction_

# -----------------------------------------------------------------------------
# Backend — ASP.NET Core (export, host env, or dotnet user-secrets)
# Double-underscore (__) maps to nested configuration keys.
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# Required for startup. Point at your SQL instance (compose host name is cortex-sql on the Docker network).
ConnectionStrings__CortexDb=Server=localhost,1433;Database=CortexDb;User Id=sa;Password=YourLocalDevSqlPassword_NotForProduction_;TrustServerCertificate=True;Encrypt=False;

# CORS allowed origins (use indexed keys for arrays). Non-Development may require explicit origins per Program.cs.
AllowedOrigins__0=http://localhost:5173
AllowedOrigins__1=http://localhost:4173

# Auth0 — placeholders only; use your tenant values
Auth0__Domain=your-tenant.us.auth0.com
Auth0__Audience=https://your-api-identifier
Auth0__ClientId=your-backend-or-swagger-oauth-client-id
Auth0__ManagementClientId=your-management-api-client-id
Auth0__ManagementApiAudience=https://your-tenant.us.auth0.com/api/v2/
# Placeholder — set via vault or secrets manager in real environments (non-dev startup may fail if missing when Management API is required)
Auth0__ManagementClientSecret=

# OpenAI — optional; leave empty to disable AI-backed features where applicable
OpenAI__ApiKey=
OpenAI__Model=gpt-4o-mini
OpenAI__EmbeddingModel=text-embedding-3-small

# Azure SignalR — optional. Omit both for in-process SignalR (single-instance style). Program.cs accepts either form.
Azure__SignalR__ConnectionString=
ConnectionStrings__AzureSignalR=

# Demo eligibility bootstrap (also tied to Development in Program.cs)
Demo__EnableEligibilityBootstrap=false

# -----------------------------------------------------------------------------
# Frontend — Vite (npm run dev). Must match where the browser can reach the API (include /api).
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:5214/api
